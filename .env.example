# Port, auf dem der Server lauscht (Coolify setzt diesen in der Regel automatisch)
PORT=3000

# Interface-Bindung. Für Container immer 0.0.0.0 lassen.
HOST=0.0.0.0

# Öffentliche Basis-URL für QR-Code und Teilnehmerlink.
# Optional: Wenn nicht gesetzt, wird die aktuelle Browser-URL der Presenter-Seite verwendet.
# PUBLIC_URL=https://umfrage.example.de

# X-Forwarded-For auswerten (nur relevant für Rate-Limiting hinter Traefik/Coolify).
# "false" setzen, wenn die App direkt ohne Reverse Proxy erreichbar ist.
TRUST_PROXY=true

# Maximale Anzahl gleichzeitiger WebSocket-Verbindungen
MAX_CONNECTIONS=5000

# Verzeichnis für Feedback-Bögen und Antworten (muss Neustarts überleben)
# DATA_DIR=./data
